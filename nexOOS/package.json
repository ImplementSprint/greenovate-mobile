    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run doctor",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "maestro:validate": "tsx scripts/validate-maestro-flows.ts",
